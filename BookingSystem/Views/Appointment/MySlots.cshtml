@using BookingSystem.Core.Entities
@using BookingSystem.Core.Enums
@model List<Appointment>
@{
    ViewData["Title"] = "My Slots";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-calendar3 text-primary me-2"></i>My Appointment Slots
        </h3>
        <p class="text-muted mb-0">Manage all your created slots and bookings.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add New Slot
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
        <div>
            You haven't created any appointment slots yet.
            <a asp-action="Create" class="alert-link fw-semibold ms-1">Create your first slot now</a>.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Time</th>
                        <th scope="col">Status</th>
                        <th scope="col">Booked By</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model)
                    {
                        <tr>
                            <td>
                                <strong>@slot.StartTime.ToString("ddd, dd MMM yyyy")</strong>
                            </td>
                            <td>
                                @slot.StartTime.ToString("hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")
                            </td>
                            <td>
                                @if (slot.Status == Status.Available)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check2-circle me-1"></i>Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-lock me-1"></i>Confirmed
                                    </span>
                                }
                            </td>
                            <td>
                                @if (slot.Status == Status.Confirmed)
                                {
                                    <span>@(slot.ApplicationUser?.Name ?? (!string.IsNullOrEmpty(slot.UserId) ? "Registered User" : "—"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (slot.Status == Status.Confirmed)
                                {
                                    <form asp-controller="Appointment" asp-action="Unbook" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                        <input type="hidden" name="appointmentId" value="@slot.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i> Cancel Booking
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Open</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
