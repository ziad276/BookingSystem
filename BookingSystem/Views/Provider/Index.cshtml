@using BookingSystem.Core.Entities
@model List<Provider>
@{
    ViewData["Title"] = "Browse Providers";
}

<div class="mb-4">
    <h3 class="fw-bold mb-1">
        <i class="bi bi-people text-primary me-2"></i>Service Providers
    </h3>
    <p class="text-muted mb-0">Browse our certified providers and schedule an appointment.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
        <div>
            No providers are registered at the moment.
            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Provider"))
            {
                <form asp-controller="Provider" asp-action="BecomeProvider" method="post" class="d-inline ms-2">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        Become the first provider!
                    </button>
                </form>
            }
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var provider in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 text-center p-3">
                    <div class="card-body d-flex flex-column align-items-center">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                            <i class="bi bi-person-fill fs-2"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-1">
                            @(provider.User?.Name ?? $"Provider #{provider.Id}")
                        </h5>
                        <p class="text-muted small mb-4">
                            @(provider.User?.Email ?? "Verified Provider")
                        </p>
                        <div class="mt-auto w-100">
                            <a asp-controller="Appointment"
                               asp-action="Index"
                               asp-route-providerId="@provider.Id"
                               class="btn btn-outline-primary w-100">
                                <i class="bi bi-calendar2-check me-1"></i> View Available Slots
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
