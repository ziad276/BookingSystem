@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 text-center py-5">
        <i class="bi bi-exclamation-octagon text-danger display-1 mb-3"></i>
        <h1 class="text-danger">An error occurred.</h1>
        <h4 class="text-muted mb-4">An error occurred while processing your request.</h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house me-1"></i> Return Home
        </a>
    </div>
</div>
